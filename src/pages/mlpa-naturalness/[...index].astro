---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { checks, scale, storyKeys } from "@/lib/mlpa-naturalness";

export function getStaticPaths() {
  return import.meta.env.PUBLIC_MLPA_NATURALNESS_API_URL
    ? [{ params: { index: undefined } }]
    : [];
}

const api = import.meta.env.PUBLIC_MLPA_NATURALNESS_API_URL ?? "";
const test = import.meta.env.PUBLIC_MLPA_NATURALNESS_TEST === "true";
---

<Layout
  title="AIが作った日本語は、自然に読める？ | Boundary Notes"
  analytics={false}
  transitions={false}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <meta slot="head" name="referrer" content="no-referrer" />
  <Header />
  <main
    id="main-content"
    class="app-layout pb-12"
    data-naturalness
    data-api={api}
    data-test={test}
  >
    <h1 class="text-2xl font-semibold">AIが作った日本語は、自然に読める？</h1>
    <p class="mt-2">MLPA Phase 2 — 日本語自然さ評価</p>
    <p class="mt-5">
      MLPAは、意味を音で伝える人工言語の研究です。復元した意味から再生成された日本語が、どのくらい自然に読めるかを調べます。
    </p>
    <p class="mt-3">
      文章Aと文章Bを読み、それぞれの自然さを1〜5で評価してください。参加は任意です。氏名やメールアドレスの入力は不要です。
    </p>
    <p id="naturalness-status" class="my-5" role="status">
      {api ? "受付状況を確認しています。" : "現在は回答を受け付けていません。"}
    </p>
    <noscript><p>回答にはJavaScriptが必要です。</p></noscript>
    <form id="naturalness-form" hidden>
      <section id="naturalness-intro">
        <h2 class="text-xl font-semibold">参加前にご確認ください</h2>
        <dl class="my-4 space-y-2">
          <dt class="font-semibold">回答の利用目的</dt><dd
            data-policy="purpose"
          >
          </dd>
          <dt class="font-semibold">保存期限</dt><dd data-policy="retention">
          </dd>
          <dt class="font-semibold">公開範囲</dt><dd data-policy="publication">
          </dd>
          <dt class="font-semibold">問い合わせ・取下げ</dt><dd
            data-policy="contact"
          >
          </dd>
        </dl>
        <p>
          送信前はいつでも中止できます。送信後の問い合わせには、完了画面に表示する回答IDをお使いください。
        </p>
        <fieldset class="my-5">
          <legend class="font-semibold">参加確認（すべて必須）</legend>
          {
            checks.map(([key, label]) => (
              <label class="flex min-h-11 items-start gap-3 py-2">
                <input
                  class="mt-1 size-5 shrink-0 accent-[var(--color-accent)]"
                  type="checkbox"
                  name={key}
                  required
                />
                <span>{label}</span>
              </label>
            ))
          }
        </fieldset>
        <button id="naturalness-start" type="button">文章を読む</button>
      </section>

      <section id="naturalness-ratings" hidden>
        <h2 tabindex="-1" class="text-xl font-semibold">文章の評価</h2>
        {
          storyKeys.map(key => (
            <section class="my-6 border-b pb-6">
              <h3 class="text-lg font-semibold">文章{key}</h3>
              <p
                class="my-3 leading-relaxed [overflow-wrap:anywhere] whitespace-pre-wrap"
                data-story={key}
              />
              <fieldset>
                <legend class="font-semibold">文章{key}の自然さ（必須）</legend>
                {scale.map((label, i) => (
                  <label class="flex min-h-11 items-center gap-3">
                    <input
                      class="size-5 accent-[var(--color-accent)]"
                      type="radio"
                      name={key}
                      value={i + 1}
                      required
                    />
                    <span>
                      {i + 1}：{label}
                    </span>
                  </label>
                ))}
              </fieldset>
            </section>
          ))
        }
        <button id="naturalness-review" type="button">回答を確認する</button>
      </section>

      <section id="naturalness-confirm" hidden>
        <h2 tabindex="-1" class="text-xl font-semibold">回答の確認</h2>
        <p class="my-3" id="naturalness-summary"></p>
        <div class="flex flex-wrap gap-3">
          <button id="naturalness-back" type="button">評点を見直す</button>
          <button id="naturalness-send" type="submit">回答を送信する</button>
        </div>
      </section>
    </form>
    <section id="naturalness-complete" hidden>
      <h2 tabindex="-1" class="text-xl font-semibold">回答を受け付けました</h2>
      <p class="my-3">ご協力ありがとうございました。</p>
      <p class="break-all" id="naturalness-receipt"></p>
    </section>
    <p id="naturalness-error" class="my-4" role="alert"></p>
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/mlpa-naturalness";
</script>

<style>
  button {
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.35rem;
  }
  button:disabled {
    opacity: 0.5;
  }
</style>
